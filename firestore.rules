rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // PUBLIC ACCESS EDITION v1.1.0
    // CAUTION: any internet user can read or submit data through these rules.
    // GitHub link possession is NOT a security boundary.
    function validEntry(entryId) {
      let d = request.resource.data;
      return d.keys().hasAll([
          'id','kind','rootId','supersedesId','truckId','truckCode',
          'driverId','driverName','date','time','category','tareKg',
          'grossKg','netKg','notes','createdAt','createdBy','deviceId'
        ])
        && d.keys().hasOnly([
          'id','kind','rootId','supersedesId','truckId','truckCode',
          'driverId','driverName','date','time','category','tareKg',
          'grossKg','netKg','notes','createdAt','createdBy','deviceId'
        ])
        && d.id == entryId
        && d.id is string && d.id.size() > 0 && d.id.size() <= 150
        && d.kind in ['measurement','void']
        && d.rootId is string && d.rootId.size() > 0 && d.rootId.size() <= 150
        && d.supersedesId is string && d.supersedesId.size() <= 150
        && d.truckId is string && d.truckId.size() > 0 && d.truckId.size() <= 150
        && d.driverId is string && d.driverId.size() > 0 && d.driverId.size() <= 150
        && d.truckCode is string && d.truckCode.size() > 0 && d.truckCode.size() <= 60
        && d.driverName is string && d.driverName.size() > 0 && d.driverName.size() <= 100
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.time is string && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.category in ['bio','nonbio']
        && d.tareKg is number && d.grossKg is number && d.netKg is number
        && d.tareKg >= 0 && d.grossKg >= d.tareKg && d.grossKg <= 1000000
        && d.netKg == d.grossKg - d.tareKg
        && d.notes is string && d.notes.size() <= 1000
        && d.createdAt is number
        && d.createdBy is string && d.createdBy.size() <= 150
        && d.deviceId is string && d.deviceId.size() <= 150;
    }
    function validTruck(truckId) {
      let d=request.resource.data;
      return d.keys().hasAll(['id','code','tareKg','active','updatedAt'])
        && d.keys().hasOnly(['id','code','tareKg','active','updatedAt'])
        && d.id == truckId && d.id is string && d.id.size() > 0 && d.id.size() <= 150
        && d.code is string && d.code.size() > 0 && d.code.size() <= 60
        && d.tareKg is number && d.tareKg >= 0 && d.tareKg <= 1000000
        && d.active is bool && d.updatedAt is number;
    }
    function validDriver(driverId) {
      let d=request.resource.data;
      return d.keys().hasAll(['id','name','active','updatedAt'])
        && d.keys().hasOnly(['id','name','active','updatedAt'])
        && d.id == driverId && d.id is string && d.id.size() > 0 && d.id.size() <= 150
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.active is bool && d.updatedAt is number;
    }

    match /entries/{entryId} {
      allow read: if true;
      allow create: if validEntry(entryId);
      // Immutable ledger: correction/void is a NEW event, not an edit or deletion.
      allow update, delete: if false;
    }
    match /trucks/{truckId} {
      allow read: if true;
      allow create, update: if validTruck(truckId);
      allow delete: if false;
    }
    match /drivers/{driverId} {
      allow read: if true;
      allow create, update: if validDriver(driverId);
      allow delete: if false;
    }
    // Old membership records remain inaccessible to public clients.
    match /members/{uid} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
